# systemd unit for ExposeChain (FastAPI/Uvicorn)
# Install to: /etc/systemd/system/exposechain.service

[Unit]
Description=ExposeChain FastAPI application
After=network.target

[Service]
Type=simple
User=vamsi
WorkingDirectory=/home/vamsi/apps/Expose-Chain
Environment="PATH=/home/vamsi/apps/Expose-Chain/venv/bin"
EnvironmentFile=/home/vamsi/apps/Expose-Chain/.env
ExecStart=/home/vamsi/apps/Expose-Chain/venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

# Memory/process hardening for a 2GB box
MemoryMax=768M
TasksMax=100

# Sandboxing. The app has no need to write outside its own working
# directory or touch other users' home directories, so these are safe:
# ProtectSystem=full leaves WorkingDirectory writable but makes /usr,
# /boot, and /etc read-only for this process.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target
